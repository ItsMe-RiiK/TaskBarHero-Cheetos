root = true

[*]
end_of_line = lf
charset = utf-8

[*.{json,py}]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

[*.{c,cpp,h,hpp}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[*.yml]
insert_final_newline = true
indent_style = space
indent_size = 2